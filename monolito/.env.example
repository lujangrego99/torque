# Copiar a .env o usar NODE_ID=node1|node2|node3 (recomendado).
# No versionar el archivo .env real.

# Identidad del nodo en el cluster fijo (obligatorio para multi-nodo).
# node1 → HTTP 3100 / HTTPS 3443 / Raft 7001 / DB taller_node1
# node2 → HTTP 3101 / HTTPS 3444 / Raft 7002 / DB taller_node2
# node3 → HTTP 3102 / HTTPS 3445 / Raft 7003 / DB taller_node3
NODE_ID=node1

# Overrides opcionales (si se omiten, se derivan de NODE_ID)
# PORT=3100
# HTTPS_PORT=3443
# RAFT_PORT=7001
# MONGODB_URI=mongodb://127.0.0.1:27017/taller_node1

ENABLE_HTTP=true

# HTTPS
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.crt
# Windows PFX (prioridad si se define):
# SSL_PFX_PATH=./certs/server.pfx
# SSL_PFX_PASSPHRASE=cambiar-en-local

# Redis (lock del TP2; NO se usa para Leader/votos/quorum/commit)
REDIS_URL=redis://127.0.0.1:6379
LOCK_TTL_MS=8000
DEMO_DELAY_MS=2000

# Winston
LOG_DIR=./logs
LOG_LEVEL=info
LOG_MAX_SIZE=5m
LOG_MAX_FILES=7d

# Timeouts Raft (ms). El election timeout se elige al azar en [MIN, MAX].
ELECTION_TIMEOUT_MIN_MS=1500
ELECTION_TIMEOUT_MAX_MS=3000
HEARTBEAT_INTERVAL_MS=500
