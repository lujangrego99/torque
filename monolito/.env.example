# Copiar a .env y ajustar. No versionar el archivo .env.

# HTTP del TP1 (se puede desactivar con ENABLE_HTTP=false)
PORT=3000
ENABLE_HTTP=true

# HTTPS (TP2)
HTTPS_PORT=3443

# Linux / OpenSSL (PEM)
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.crt

# Windows / PowerShell (PFX). Si se definen, tienen prioridad sobre KEY/CERT.
# SSL_PFX_PATH=./certs/server.pfx
# SSL_PFX_PASSPHRASE=cambiar-en-local

# Redis (Linux) o Memurai (Windows). Misma URL.
REDIS_URL=redis://127.0.0.1:6379

# TTL del lock en milisegundos. Tiene que ser mayor que DEMO_DELAY_MS.
LOCK_TTL_MS=8000

# Retardo artificial dentro de la sección crítica (para ver la carrera).
DEMO_DELAY_MS=2000

# MongoDB (TP3). Sin credenciales en el ejemplo local.
MONGODB_URI=mongodb://127.0.0.1:27017/taller

# Winston (TP3)
LOG_DIR=./logs
LOG_LEVEL=info
LOG_MAX_SIZE=5m
LOG_MAX_FILES=7d
