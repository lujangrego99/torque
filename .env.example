# Variables de docker-compose.yml (todas opcionales; estos son los valores por defecto).
# cp .env.example .env   — el .env real no se versiona.

# Puertos publicados en la PC (solo el gateway se publica)
GATEWAY_HTTP_PORT=3000
GATEWAY_HTTPS_PORT=3443

# inventory-service: lock Redis y delay de la demo de carrera (TTL > delay)
LOCK_TTL_MS=8000
DEMO_DELAY_MS=1000

# workorders-service: timeouts de las llamadas a otros servicios (ms)
VEHICLES_TIMEOUT_MS=2000
INVENTORY_TIMEOUT_MS=5000

# api-gateway: timeout del proxy (ms)
PROXY_TIMEOUT_MS=15000

LOG_LEVEL=info
