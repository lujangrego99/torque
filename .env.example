# Variables de docker-compose.yml. El .env real NO se versiona.
#   bash scripts/generar-env.sh   → crea .env a partir de este archivo y completa
#                                   JWT_SECRET y ADMIN_PASSWORD con valores aleatorios.
# (o a mano: cp .env.example .env y completar las dos obligatorias)

# --- Seguridad (TP7) — OBLIGATORIAS -------------------------------------------
# Secreto HS256 compartido por auth-service (firma) y los servicios que validan.
# Aleatorio, mínimo 32 caracteres: openssl rand -base64 48
JWT_SECRET=
# Contraseña del administrador inicial (mínimo 8 caracteres)
ADMIN_PASSWORD=

# --- Seguridad (TP7) — opcionales ---------------------------------------------
ADMIN_EMAIL=admin@torque.local
ADMIN_NOMBRE=Administrador
# Vigencia del access token ("15m", "1h", "30s")
JWT_EXPIRES_IN=15m
# Costo de bcrypt (2^n)
BCRYPT_ROUNDS=12

# --- Puertos publicados en la PC (solo el gateway se publica) ------------------
GATEWAY_HTTP_PORT=3000
GATEWAY_HTTPS_PORT=3443

# inventory-service: lock Redis y delay de la demo de carrera (TTL > delay)
LOCK_TTL_MS=8000
DEMO_DELAY_MS=1000

# workorders-service: timeouts de las llamadas a otros servicios (ms)
VEHICLES_TIMEOUT_MS=2000
INVENTORY_TIMEOUT_MS=5000

# api-gateway: timeout del proxy (ms)
PROXY_TIMEOUT_MS=15000

LOG_LEVEL=info
