# api-gateway — copiar a .env para ejecución local. No versionar .env.
SERVICE_NAME=api-gateway

# Puerto HTTP (es el único servicio publicado hacia el host)
PORT=3000

# HTTPS para el acceso externo (TP2). Solo se activa si existen los archivos.
# Generar con: bash scripts/generar-certificado.sh
HTTPS_PORT=3443
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.crt

# Servicios internos. Local: localhost + puerto de cada uno.
# Docker: http://<nombre-del-servicio>:3000 (DNS interno de Compose)
VEHICLES_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:3002
WORKORDERS_SERVICE_URL=http://localhost:3003
AUTH_SERVICE_URL=http://localhost:3004

# Timeout del proxy (ms). Debe cubrir la creación de una orden, que hace
# varias llamadas internas (incluido el delay de demo del lock).
PROXY_TIMEOUT_MS=15000
# Timeout para consultar /health de cada servicio
HEALTH_TIMEOUT_MS=2000

LOG_LEVEL=info
