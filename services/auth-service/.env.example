# auth-service — copiar a .env para ejecución local. No versionar .env.
SERVICE_NAME=auth-service

# Puerto HTTP interno. Local: 3004 · Docker Compose: 3000
PORT=3004

# Base propia del servicio: solo auth-service guarda usuarios y hashes.
# Local:  mongodb://127.0.0.1:27017/auth
# Docker: mongodb://auth-db:27017/auth
MONGODB_URI=mongodb://127.0.0.1:27017/auth
MONGO_RETRY_MS=3000

# Firma HS256 de los access tokens. Mínimo 32 caracteres, aleatorio, y el MISMO
# valor en los servicios que validan tokens. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=5m
# Cierre de sesión por inactividad (sin renovar el token en este lapso)
SESSION_IDLE=15m
JWT_ISSUER=torque-auth
JWT_AUDIENCE=torque

# Costo de bcrypt
BCRYPT_ROUNDS=12

# Administrador inicial (se crea si no existe). Contraseña: mínimo 8 caracteres.
ADMIN_EMAIL=admin@torque.local
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador

LOG_LEVEL=info
