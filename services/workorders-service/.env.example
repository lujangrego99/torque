# workorders-service — copiar a .env para ejecución local. No versionar .env.
SERVICE_NAME=workorders-service

# Puerto HTTP interno. Local: 3003 · Docker Compose: 3000
PORT=3003

# Base propia del servicio (solo órdenes; vehículos y stock NO se leen de acá).
# Local:  mongodb://127.0.0.1:27017/workorders
# Docker: mongodb://workorders-db:27017/workorders
MONGODB_URI=mongodb://127.0.0.1:27017/workorders
MONGO_RETRY_MS=3000

# Servicios remotos (interfaz pública HTTP). Nunca IPs fijas en el código.
# Local:  http://localhost:3001 / http://localhost:3002
# Docker: http://vehicles-service:3000 / http://inventory-service:3000
VEHICLES_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:3002

# Timeouts de las llamadas remotas (ms). El de inventario tiene que superar el
# DEMO_DELAY_MS de inventory-service, porque el descuento con lock lo incluye.
VEHICLES_TIMEOUT_MS=2000
INVENTORY_TIMEOUT_MS=5000

LOG_LEVEL=info
