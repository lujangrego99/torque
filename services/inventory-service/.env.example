# inventory-service — copiar a .env para ejecución local. No versionar .env.
SERVICE_NAME=inventory-service

# Puerto HTTP interno. Local: 3002 · Docker Compose: 3000
PORT=3002

# Base propia del servicio (nadie más la usa).
# Local:  mongodb://127.0.0.1:27017/inventory
# Docker: mongodb://inventory-db:27017/inventory
MONGODB_URI=mongodb://127.0.0.1:27017/inventory
MONGO_RETRY_MS=3000

# Redis (Linux / Docker) o Memurai (Windows). Mismo formato de URL.
# Local:  redis://127.0.0.1:6379
# Docker: redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# Lock de stock (TP2). El TTL tiene que ser mayor que el delay de la demo.
LOCK_TTL_MS=8000
DEMO_DELAY_MS=2000

# Cargar los 3 repuestos de ejemplo si la colección está vacía
SEED_ON_START=true

# Verificación de los access tokens emitidos por auth-service (HS256).
# MISMO valor que JWT_SECRET de auth-service. Mínimo 32 caracteres.
JWT_SECRET=
JWT_ISSUER=torque-auth
JWT_AUDIENCE=torque

LOG_LEVEL=info
