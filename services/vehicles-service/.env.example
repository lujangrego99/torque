# vehicles-service — copiar a .env para ejecución local. No versionar .env.
SERVICE_NAME=vehicles-service

# Puerto HTTP interno. Local: 3001 · Docker Compose: 3000
PORT=3001

# Base propia del servicio (nadie más la usa).
# Local:  mongodb://127.0.0.1:27017/vehicles
# Docker: mongodb://vehicles-db:27017/vehicles
MONGODB_URI=mongodb://127.0.0.1:27017/vehicles

# Reintento de conexión a Mongo al arrancar (ms entre intentos)
MONGO_RETRY_MS=3000

# Cargar los 3 vehículos de ejemplo si la colección está vacía
SEED_ON_START=true

LOG_LEVEL=info
